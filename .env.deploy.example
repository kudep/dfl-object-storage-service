# MinIO root credentials (admin) — CHANGE THESE
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-strong-password

# MinIO ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket name
MINIO_BUCKET=videos

# Recorder service account — CHANGE THESE
RECORDER_ACCESS_KEY=recorder
RECORDER_SECRET_KEY=change-me-strong-password

# Teacher service account — CHANGE THESE
TEACHER_ACCESS_KEY=teacher
TEACHER_SECRET_KEY=change-me-strong-password

# Host user/group for bind mount permissions
UID=1000
GID=1000
