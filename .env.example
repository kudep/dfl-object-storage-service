# MinIO root credentials (admin)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# MinIO ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Bucket name
MINIO_BUCKET=videos

# Recorder service account
RECORDER_ACCESS_KEY=recorder
RECORDER_SECRET_KEY=recorder-secret-change-me

# Teacher service account
TEACHER_ACCESS_KEY=teacher
TEACHER_SECRET_KEY=teacher-secret-change-me
